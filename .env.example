# Environment for docker compose.
# Copy to .env next to docker-compose.yml: cp .env.example .env
# docker compose stops with an error if any of these keys is missing.
# Generate MONGO_PASSWORD and PROXY_TOKEN with: openssl rand -hex 32
# (hex needs no URL encoding inside MONGO_URL)

# MongoDB root credentials (mongo container init)
MONGO_USER=change-me
MONGO_PASSWORD=change-me-strong-password

# Backend connection string; must use the same user and password as above
MONGO_URL=mongodb://<user>:<password>@mongo:27017/techrelative?authSource=admin

# CORS allowed origin (your domain)
CORS_ORIGIN=https://your-domain.example

# Shared secret between Nginx and Express
PROXY_TOKEN=generate-with-openssl-rand-hex-32
